# 环境变量占位（SEC-KEY-06：仅占位值，不入库真值；.env 在 .gitignore）。
# 复制为 .env 或按部署面注入；完整语义见 algo.md §13 配置表。

# 数据入口（环境隔离纪律：只连本项目 deploy/docker-compose.dev.yml 的 thermio- 栈）
KAFKA_BROKERS=localhost:9092
TSDB_DSN=postgres://tsdb_algo:<CHANGE_ME>@localhost:5434/thermio_ts

# 中台 internal 面（对 PG 零直连：本服务无任何 PG 配置项——结构性保证）
API_INTERNAL_BASE_URL=http://localhost:8080
SVC_TOKEN_ALGO=<CHANGE_ME>

# 调度（默认启用集见 algo/config.py DEFAULT_JOBS；forecast/optimize 槽位默认禁用）
ALGO_TZ=Asia/Shanghai
ALGO_LOG_LEVEL=INFO
# ALGO_JOBS_ENABLED=fdd_eval,fdd_report_day,fdd_report_week,weather_actual,weather_forecast,snapshot_refresh

# FDD
THRESHOLDS_FILE=config/thresholds.yaml

# 天气（站点 ID 语义由供应商定；open-meteo 为 "lat,lon"）
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_STATIONS=31.2304:121.4737

# 可观测性
ALGO_METRICS_PORT=9101
